---
import { site } from '../data/site';
import { topics } from '../data/topics';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo size="lg" />
        <p class="footer-tagline">
          A journal of attention, design &amp; the texture of digital life.
        </p>
        <p class="footer-issue">
          Issue {site.issue.number} <span aria-hidden="true">·</span> {site.issue.season}
        </p>
      </div>

      <div class="footer-columns">
        <div class="footer-column">
          <p class="footer-label">Explore</p>
          <ul>
            {site.nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-column">
          <p class="footer-label">Topics</p>
          <ul>
            {topics.map((topic) => (
              <li><a href={withBase(`/topics/${topic.slug}/`)}>{topic.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-column">
          <p class="footer-label">Elsewhere</p>
          <ul>
            <li>
              <a href={withBase('/rss.xml')}>
                RSS feed
                <Icon name="rss" size={14} />
              </a>
            </li>
            <li>
              <a href={withBase('/journal/')} data-search-open>
                Search
                <Icon name="search" size={14} />
              </a>
            </li>
            <li>
              <a href="#top">
                Back to top
                <Icon name="arrow-up" size={14} />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© {year} Brine. All rights reserved.</p>
      <p class="footer-colophon">{site.colophon.platform}</p>
      <p class="footer-credit">
        Photography via{' '}
        <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>{' '}
        and{' '}
        <a href="https://www.pexels.com" target="_blank" rel="noopener noreferrer">Pexels</a>.
      </p>
    </div>

    <div class="footer-wordmark" aria-hidden="true">Brine<span>.</span></div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    border-top: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-tagline {
    max-width: 20rem;
    margin-top: 1.5rem;
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .footer-issue {
    margin-top: 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-label {
    margin-bottom: 1rem;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.8rem;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 450;
    color: var(--ink-2);
    transition: color var(--duration-fast) ease;
  }

  .footer-column a:hover {
    color: var(--accent);
  }

  .footer-column a svg {
    color: var(--muted);
  }

  .footer-column a:hover svg {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.3rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .footer-copy {
    color: var(--ink-2);
  }

  .footer-colophon {
    max-width: 24rem;
  }

  .footer-credit {
    max-width: 30rem;
  }

  .footer-credit a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color var(--duration-fast) ease;
  }

  .footer-credit a:hover {
    color: var(--accent);
  }

  .footer-wordmark {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 0.06em;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 15vw, 12rem);
    font-weight: 500;
    line-height: 0.72;
    letter-spacing: -0.055em;
    color: var(--line);
    white-space: nowrap;
    user-select: none;
  }

  .footer-wordmark span {
    color: var(--accent);
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .footer-columns {
      gap: 1.5rem;
    }
  }

  @media (max-width: 620px) {
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .footer-column:last-child {
      grid-column: span 2;
    }

    .footer-column:last-child ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-wordmark {
      font-size: clamp(4rem, 22vw, 6rem);
    }
  }
</style>
