---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { topics } from '../data/topics';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const featuredArticles = await getCollection(
  'articles',
  ({ data }) => data.featured && !data.draft,
);
const featured = featuredArticles[0];

const isActive = (section: string) => {
  if (section === 'journal') return pathname.startsWith(withBase('/journal/'));
  if (section === 'topics') return pathname.startsWith(withBase('/topics/'));
  return pathname === withBase(`/${section}/`) || pathname === withBase(`/${section}`);
};
---

<div class="announcement">
  <div class="container container--wide announcement__inner">
    <p class="announcement__issue">
      <span class="announcement__dot" aria-hidden="true"></span>
      Issue {site.issue.number} <span class="announcement__sep">·</span> {site.issue.season}
    </p>
    <p class="announcement__name">{site.issue.name}</p>
    {featured && (
      <a class="announcement__link" href={withBase(`/journal/${featured.id}/`)}>
        <span class="announcement__link-long">Read the cover story</span>
        <span class="announcement__link-short">Cover story</span>
        <Icon name="arrow-right" size={13} />
      </a>
    )}
  </div>
</div>

<header class="site-header">
  <div class="container container--wide header__inner">
    <Logo />

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={isActive(item.section) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a
        class="header-search"
        href={withBase('/journal/')}
        data-search-open
        aria-label="Search the journal"
      >
        <Icon name="search" size={17} />
        <span class="header-search__label">Search</span>
        <kbd aria-hidden="true">/</kbd>
      </a>

      <span class="header__divider" aria-hidden="true"></span>

      <ThemeToggle />

      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label="Open menu">
          <Icon name="menu" size={19} />
        </summary>

        <div class="mobile-panel">
          <nav aria-label="Mobile primary">
            <ul class="mobile-nav">
              {site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.section) ? 'page' : undefined}
                  >
                    <span>{item.label}</span>
                    <Icon name="arrow-up-right" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="mobile-panel__section">
            <p class="mobile-panel__label">Topics</p>
            <ul class="mobile-topics">
              {topics.map((topic) => (
                <li>
                  <a href={withBase(`/topics/${topic.slug}/`)}>{topic.name}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="mobile-panel__footer">
            <a class="mobile-panel__search" href={withBase('/journal/')} data-search-open>
              <Icon name="search" size={16} />
              Search the journal
            </a>
            <a class="mobile-panel__rss" href={withBase('/rss.xml')}>
              <Icon name="rss" size={16} />
              RSS feed
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .announcement {
    background: var(--band-bg);
    color: var(--band-ink);
    font-family: var(--font-ui);
  }

  .announcement__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: 2.25rem;
  }

  .announcement__issue {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--band-muted);
    white-space: nowrap;
  }

  .announcement__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .announcement__sep {
    opacity: 0.6;
  }

  .announcement__name {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--band-ink);
    text-align: center;
    white-space: nowrap;
  }

  .announcement__link {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--band-ink);
    transition: color var(--duration-fast) ease;
  }

  .announcement__link:hover {
    color: var(--band-muted);
  }

  .announcement__link svg {
    transition: transform var(--duration) var(--ease-out);
  }

  .announcement__link:hover svg {
    transform: translateX(3px);
  }

  .announcement__link-short {
    display: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-height);
  }

  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 1.9rem;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.55rem 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 480;
    letter-spacing: 0.01em;
    color: var(--ink-2);
    transition: color var(--duration-fast) ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 480;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .header-search:hover {
    border-color: var(--line-strong);
    color: var(--ink);
    background: var(--surface);
  }

  .header-search kbd {
    display: none;
    min-width: 1.15rem;
    padding: 0.12rem 0.22rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    line-height: 1.2;
    text-align: center;
    color: var(--muted);
    background: var(--surface-2);
  }

  @media (min-width: 900px) {
    :global(.js) .header-search kbd {
      display: inline-block;
    }
  }

  .header__divider {
    width: 1px;
    height: 1.4rem;
    margin-inline: 0.35rem;
    background: var(--line);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:hover {
    border-color: var(--line-strong);
    background: var(--surface);
  }

  .mobile-menu[open] summary {
    border-color: var(--ink);
    background: var(--surface);
  }

  .mobile-panel {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    z-index: 80;
    width: min(22rem, calc(100vw - 2rem));
    max-height: calc(100svh - var(--header-height) - 2rem);
    overflow-y: auto;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-dialog);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] .mobile-panel {
      animation: panel-in 220ms var(--ease-out) both;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-nav svg {
    color: var(--muted);
  }

  .mobile-panel__section {
    padding-top: 1.15rem;
  }

  .mobile-panel__label {
    margin-bottom: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mobile-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }

  .mobile-topics a {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--ink-2);
    padding: 0.2rem 0;
  }

  .mobile-topics a:hover {
    color: var(--accent);
  }

  .mobile-panel__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.2rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .mobile-panel__search,
  .mobile-panel__rss {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-2);
    min-height: 2.25rem;
  }

  .mobile-panel__search:hover,
  .mobile-panel__rss:hover {
    color: var(--accent);
  }

  @media (max-width: 899px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .header__inner {
      gap: 0.75rem;
    }

    .announcement__inner {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    .announcement__name {
      display: none;
    }

    .announcement__link-long {
      display: none;
    }

    .announcement__link-short {
      display: inline;
    }

    .header-search__label {
      display: none;
    }

    .header-search {
      width: 2.75rem;
      justify-content: center;
      padding: 0.4rem;
    }

    .header__divider {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .announcement__issue {
      font-size: 0.625rem;
      letter-spacing: 0.05em;
    }

    .announcement__link {
      font-size: 0.625rem;
    }

    .header__actions {
      gap: 0.25rem;
    }

    .header-search,
    .mobile-menu summary {
      width: 2.5rem;
      height: 2.5rem;
      min-height: 2.5rem;
    }
  }

  @media (max-width: 350px) {
    .announcement__issue {
      display: none;
    }

    .announcement__inner {
      grid-template-columns: 1fr;
    }

    .announcement__link {
      justify-self: start;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');

  if (menu) {
    const summary = menu.querySelector('summary');

    const closeMenu = () => {
      menu.open = false;
    };

    document.addEventListener('click', (event) => {
      if (!menu.open) return;
      if (event.target instanceof Node && !menu.contains(event.target)) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        event.preventDefault();
        closeMenu();
        summary?.focus();
      }
    });

    menu.querySelectorAll('.mobile-panel a, .mobile-panel button').forEach((element) => {
      element.addEventListener('click', closeMenu);
    });

    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>
