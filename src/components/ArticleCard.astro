---
import { Image } from 'astro:assets';
import type { Article } from '../lib/articles';
import {
  articleUrl,
  estimateReadingTime,
  formatDate,
  formatReadingTime,
  getArticleTopic,
  topicUrl,
} from '../lib/articles';

interface Props {
  article: Article;
  variant?: 'grid' | 'list';
  headingLevel?: 'h2' | 'h3';
  showExcerpt?: boolean;
  eager?: boolean;
  index?: number;
}

const {
  article,
  variant = 'grid',
  headingLevel = 'h3',
  showExcerpt = true,
  eager = false,
  index,
} = Astro.props;

const Heading = headingLevel;
const topic = getArticleTopic(article);
const minutes = estimateReadingTime(article.body);
const href = articleUrl(article);
const number = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<article
  class:list={['card', `card--${variant}`]}
  data-article-card
  data-slug={article.id}
  data-topic={article.data.category}
>
  {variant === 'grid' ? (
    <a class="card__media" href={href} aria-label={`Read “${article.data.title}”`}>
      <Image
        class="card__image"
        src={article.data.cover}
        alt={article.data.coverAlt}
        widths={[400, 640, 900]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        quality={82}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        style={`object-position: ${article.data.coverPosition}`}
      />
    </a>
  ) : (
    <a class="card__thumb" href={href} aria-label={`Read “${article.data.title}”`}>
      <Image
        class="card__image"
        src={article.data.cover}
        alt={article.data.coverAlt}
        widths={[160, 240, 320]}
        sizes="(max-width: 640px) 88px, 112px"
        quality={80}
        loading="lazy"
        decoding="async"
        style={`object-position: ${article.data.coverPosition}`}
      />
    </a>
  )}

  <div class="card__body">
    <div class="card__meta">
      {number && <span class="card__number" aria-hidden="true">{number}</span>}
      <a class="kicker" href={topicUrl(topic.slug)}>{topic.name}</a>
      <span class="card__meta-divider" aria-hidden="true">/</span>
      <span>{formatReadingTime(minutes)}</span>
    </div>

    <Heading class="card__title">
      <a href={href}>{article.data.title}</a>
    </Heading>

    {showExcerpt && variant === 'grid' && (
      <p class="card__excerpt">{article.data.description}</p>
    )}

    <div class="card__footer">
      <time datetime={article.data.publishedAt.toISOString()}>
        {formatDate(article.data.publishedAt, 'short')}
      </time>
      <span class="card__footer-dot" aria-hidden="true"></span>
      <span>{article.data.author}</span>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    aspect-ratio: 4 / 3;
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .card__media:hover .card__image {
    transform: scale(1.025);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 1.1rem;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .card__number {
    margin-right: 0.15rem;
    font-variant-numeric: tabular-nums;
    color: var(--line-strong);
  }

  .card__meta .kicker::before {
    width: 0.3rem;
    height: 0.3rem;
  }

  .card__meta-divider {
    color: var(--line-strong);
  }

  .card__title {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.2rem + 0.45vw, 1.65rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.022em;
  }

  .card__title a {
    transition: color var(--duration-fast) ease;
  }

  .card__title a:hover {
    color: var(--accent);
  }

  .card__excerpt {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__footer {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .card__footer-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  /* Compact editorial row */

  .card--list {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
  }

  .card--list .card__thumb {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    aspect-ratio: 1 / 1;
  }

  .card--list .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .card--list .card__thumb:hover .card__image {
    transform: scale(1.035);
  }

  .card--list .card__body {
    padding-top: 0;
  }

  .card--list .card__title {
    margin-top: 0.45rem;
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.5rem);
    line-height: 1.16;
  }

  .card--list .card__excerpt {
    font-size: 0.92rem;
    -webkit-line-clamp: 2;
  }

  .card--list .card__footer {
    padding-top: 0.65rem;
  }

  @media (max-width: 640px) {
    .card--list {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.15rem;
    }

    .card--list .card__title {
      font-size: 1.2rem;
    }

    .card--list .card__excerpt {
      display: none;
    }

    .card--list .card__footer {
      padding-top: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__image {
      transition: none;
    }
  }
</style>
