---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WaveMark from '../components/WaveMark.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Page not found"
  description="This page has drifted out to sea. Return to the journal, browse by topic, or search Brine."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container container--wide">
      <div class="not-found__top" data-reveal>
        <p class="eyebrow eyebrow--accent">
          <span class="eyebrow__rule"></span>
          Error 404
        </p>
        <p class="not-found__note">Off the map</p>
      </div>

      <div class="not-found__grid">
        <div class="not-found__mark-wrap" data-reveal>
          <WaveMark class="not-found__mark" />
          <p class="not-found__code" aria-hidden="true">404</p>
        </div>

        <div class="not-found__body" data-reveal style="--reveal-delay: 80ms">
          <h1 class="not-found__title" id="not-found-title">This page has drifted out to sea.</h1>
          <p class="not-found__copy">
            The link may be old, the address may be wrong, or the page may never have existed. The
            journal is still here, and the water is fine.
          </p>

          <div class="not-found__actions">
            <a class="btn" href={withBase('/')}>
              Back to the shore
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="text-link" href={withBase('/journal/')} data-search-open>
              Search the journal
              <Icon name="search" size={15} />
            </a>
          </div>

          <div class="not-found__links">
            <a href={withBase('/journal/')}>
              <span class="not-found__link-label">Read</span>
              <span class="not-found__link-title">The journal</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
            <a href={withBase('/topics/')}>
              <span class="not-found__link-label">Browse</span>
              <span class="not-found__link-title">Topics</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
            <a href={withBase('/archive/')}>
              <span class="not-found__link-label">Find</span>
              <span class="not-found__link-title">Archive</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: var(--section-space);
  }

  .not-found__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .not-found__note {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .not-found__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-top: clamp(3rem, 6vw, 5.5rem);
  }

  .not-found__mark-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 18rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--surface);
    overflow: hidden;
  }

  .not-found__mark {
    width: 42%;
    height: auto;
    color: var(--accent);
    opacity: 0.9;
  }

  .not-found__code {
    position: absolute;
    right: 1rem;
    bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 480;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--line);
    user-select: none;
  }

  .not-found__title {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 1.9rem + 3.8vw, 5rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .not-found__copy {
    max-width: 34rem;
    margin-top: 1.2rem;
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
    margin-top: 1.6rem;
  }

  .not-found__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .not-found__links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    gap: 0.15rem;
    padding: 0.65rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: var(--radius-xs);
    transition: background-color var(--duration-fast) ease;
  }

  .not-found__links a:hover {
    background: var(--accent-soft);
  }

  .not-found__link-label {
    grid-column: 1 / -1;
    font-family: var(--font-ui);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .not-found__link-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .not-found__links svg {
    align-self: center;
    color: var(--muted);
    transition:
      transform var(--duration) var(--ease-out),
      color var(--duration-fast) ease;
  }

  .not-found__links a:hover svg {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .not-found__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .not-found__mark-wrap {
      min-height: 14rem;
    }

    .not-found__mark {
      width: 9rem;
    }
  }

  @media (max-width: 520px) {
    .not-found__links {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .not-found__note {
      display: none;
    }

    .not-found__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
