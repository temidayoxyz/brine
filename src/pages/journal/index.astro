---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import PageMasthead from '../../components/PageMasthead.astro';
import { topics } from '../../data/topics';
import {
  articleCountLabel,
  articleUrl,
  getPublishedArticles,
  getTopicCounts,
} from '../../lib/articles';
import { absoluteUrl, withBase } from '../../lib/paths';

const articles = await getPublishedArticles();
const counts = getTopicCounts(articles);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The journal — Brine',
  description: 'Every story in Brine, the independent journal of attention, design and digital life.',
  url: absoluteUrl('/journal/'),
  inLanguage: 'en-GB',
  hasPart: articles.map((article) => ({
    '@type': 'Article',
    headline: article.data.title,
    url: absoluteUrl(articleUrl(article)),
    datePublished: article.data.publishedAt.toISOString(),
  })),
};
---

<BaseLayout
  title="The journal"
  description="Every story in Brine — essays on attention, design, digital life, culture and the everyday."
  jsonLd={jsonLd}
>
  <PageMasthead
    eyebrow="The journal"
    title="All stories"
    intro="Every essay in the journal, in the order we published it. Read slowly, follow a thread, or start anywhere."
    meta={articleCountLabel(articles.length)}
  >
    <Fragment slot="aside">
      <a class="text-link masthead-link" href={withBase('/journal/')} data-search-open>
        Search the journal
        <Icon name="search" size={15} />
      </a>
    </Fragment>
  </PageMasthead>

  <section class="journal" aria-labelledby="journal-list-title">
    <div class="container container--wide">
      <h2 class="visually-hidden" id="journal-list-title">Stories</h2>

      <div class="filter" data-journal-filter>
        <p class="filter__label">Filter by topic</p>
        <nav class="filter__links" aria-label="Filter stories by topic">
          <a
            href={withBase('/journal/')}
            class="filter__link is-active"
            data-filter="all"
            data-label="all topics"
            aria-current="true"
          >
            All <span>{articles.length}</span>
          </a>
          {topics.map((topic) => (
            <a
              href={withBase(`/topics/${topic.slug}/`)}
              class="filter__link"
              data-filter={topic.slug}
              data-label={topic.name}
            >
              {topic.name} <span>{counts[topic.slug]}</span>
            </a>
          ))}
        </nav>
        <p class="filter__status" data-filter-status role="status" aria-live="polite">
          Showing all {articles.length} stories
        </p>
      </div>

      <div class="journal-grid" data-journal-grid>
        {articles.map((article, index) => (
          <div data-reveal style={`--reveal-delay: ${(index % 2) * 70}ms`}>
            <ArticleCard article={article} index={index} eager={index < 2} />
          </div>
        ))}
      </div>

      <div class="journal-empty" data-journal-empty hidden>
        <p class="journal-empty__title">Nothing here yet.</p>
        <p>Try another topic, or browse the full journal.</p>
        <a class="text-link" href={withBase('/journal/')} data-filter="all">
          Show all stories
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead-link {
    margin-top: 1.4rem;
  }

  .journal {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .filter__label {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .filter__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filter__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 480;
    color: var(--ink-2);
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .filter__link span {
    font-size: 0.625rem;
    color: var(--muted);
  }

  .filter__link:hover {
    border-color: var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .filter__link.is-active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .filter__link.is-active span {
    color: var(--bg);
    opacity: 0.65;
  }

  .filter__status {
    margin-left: auto;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .journal-empty {
    padding: 4rem 0;
    text-align: center;
  }

  .journal-empty__title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .journal-empty p:not(.journal-empty__title) {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .journal-empty .text-link {
    margin-top: 1.4rem;
  }

  @media (max-width: 700px) {
    .filter__status {
      flex-basis: 100%;
      margin-left: 0;
    }

    .journal-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .filter__links {
      gap: 0.2rem;
    }

    .filter__link {
      padding-inline: 0.55rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-journal-filter]');
  const grid = document.querySelector<HTMLElement>('[data-journal-grid]');
  const empty = document.querySelector<HTMLElement>('[data-journal-empty]');

  if (root && grid) {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-filter]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-article-card]'));
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const valid = new Set(links.map((link) => link.dataset.filter ?? 'all'));

    const apply = (filter: string, updateUrl: boolean) => {
      const next = valid.has(filter) ? filter : 'all';
      let visible = 0;

      for (const card of cards) {
        const show = next === 'all' || card.dataset.topic === next;
        const item = card.parentElement ?? card;
        item.hidden = !show;
        if (show) visible += 1;
      }

      for (const link of links) {
        const active = link.dataset.filter === next;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      const activeLink = links.find((link) => link.dataset.filter === next);
      const label = activeLink?.dataset.label ?? 'all topics';

      if (status) {
        status.textContent =
          next === 'all'
            ? `Showing all ${cards.length} stories`
            : `Showing ${visible} ${visible === 1 ? 'story' : 'stories'} in ${label}`;
      }

      if (empty) empty.hidden = visible !== 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (next === 'all') url.searchParams.delete('topic');
        else url.searchParams.set('topic', next);
        window.history.pushState({ topic: next }, '', url);
      }
    };

    for (const link of links) {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        apply(link.dataset.filter ?? 'all', true);
      });
    }

    const initial = new URL(window.location.href).searchParams.get('topic') ?? 'all';
    apply(initial, false);

    window.addEventListener('popstate', () => {
      const topic = new URL(window.location.href).searchParams.get('topic') ?? 'all';
      apply(topic, false);
    });

    const emptyLink = empty?.querySelector<HTMLAnchorElement>('[data-filter]');
    emptyLink?.addEventListener('click', (event) => {
      event.preventDefault();
      apply('all', true);
    });
  }
</script>
