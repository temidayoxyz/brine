---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareButton from '../../components/ShareButton.astro';
import WaveMark from '../../components/WaveMark.astro';
import { editorialAuthor } from '../../data/authors';
import {
  articleUrl,
  estimateReadingTime,
  formatDate,
  getArticleTopic,
  getPublishedArticles,
  getRelatedArticles,
  isoDuration,
  topicUrl,
  wordCount,
} from '../../lib/articles';
import { absoluteUrl, withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const articles = await getPublishedArticles();
const topic = getArticleTopic(article);
const minutes = estimateReadingTime(article.body);
const words = wordCount(article.body);
const articleIndex = articles.findIndex((item) => item.id === article.id);
const newer = articleIndex > 0 ? articles[articleIndex - 1] : null;
const older = articleIndex < articles.length - 1 ? articles[articleIndex + 1] : null;
const related = getRelatedArticles(article, articles, 3);

const canonical = absoluteUrl(articleUrl(article));
const og = await getImage({
  src: article.data.cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const ogImage = absoluteUrl(og.src);
const shareUrl = canonical;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  image: [ogImage],
  datePublished: article.data.publishedAt.toISOString(),
  ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
  author: {
    '@type': 'Organization',
    name: article.data.author,
    url: absoluteUrl('/about/'),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Brine',
    url: absoluteUrl('/'),
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/icon-512.png'),
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: canonical,
  articleSection: topic.name,
  keywords: [...article.data.tags, ...article.data.keywords].join(', '),
  wordCount: words,
  timeRequired: isoDuration(minutes),
  inLanguage: 'en-GB',
  isAccessibleForFree: true,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Journal',
      item: absoluteUrl('/journal/'),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: topic.name,
      item: absoluteUrl(topicUrl(topic.slug)),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={ogImage}
  imageAlt={article.data.coverAlt}
  type="article"
  publishedTime={article.data.publishedAt}
  modifiedTime={article.data.updatedAt}
  section={topic.name}
  tags={article.data.tags}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <ReadingProgress />

  <article class="article" data-reading-article>
    <header class="article-head">
      <div class="container container--wide">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href={withBase('/journal/')}>Journal</a>
          <span aria-hidden="true">/</span>
          <a href={topicUrl(topic.slug)}>{topic.name}</a>
        </nav>

        <div class="article-head__grid">
          <div class="article-head__main">
            <a class="kicker" href={topicUrl(topic.slug)}>{topic.name}</a>
            <h1 class="article-title" data-reveal>{article.data.title}</h1>
            <p class="article-standfirst" data-reveal style="--reveal-delay: 80ms">
              {article.data.description}
            </p>
          </div>

          <aside class="article-head__aside" aria-label="Article details">
            <div class="article-byline">
              <p class="article-byline__label">Written by</p>
              <p class="article-byline__name">{article.data.author}</p>
            </div>

            <dl class="article-facts">
              <div>
                <dt>Published</dt>
                <dd>
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                </dd>
              </div>
              <div>
                <dt>Reading time</dt>
                <dd>{minutes} minutes</dd>
              </div>
              <div>
                <dt>Filed under</dt>
                <dd><a href={topicUrl(topic.slug)}>{topic.name}</a></dd>
              </div>
            </dl>

            <div class="article-share">
              <ShareButton url={shareUrl} title={article.data.title} />
            </div>
          </aside>
        </div>
      </div>
    </header>

    <figure class="article-cover">
      <div class="container container--wide">
        <div class="article-cover__frame" data-reveal>
          <Image
            class="article-cover__image"
            src={article.data.cover}
            alt={article.data.coverAlt}
            widths={[720, 1080, 1440, 1800]}
            sizes="100vw"
            quality={85}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={`object-position: ${article.data.coverPosition}`}
          />
        </div>
        {(article.data.coverCaption || article.data.coverCredit) && (
          <figcaption class="article-cover__caption">
            <span>{article.data.coverCaption}</span>
            <span class="article-cover__credit">{article.data.coverCredit}</span>
          </figcaption>
        )}
      </div>
    </figure>

    <div class="article-body">
      <div class="container container--text">
        <div class="prose">
          <Content />
        </div>

        <footer class="article-footer">
          <div class="article-tags" aria-label="Tags">
            {article.data.tags.map((tag) => <span>#{tag}</span>)}
          </div>
          <a class="arrow-link article-footer__back" href={withBase('/journal/')}>
            <Icon name="arrow-left" size={15} />
            All stories
          </a>
        </footer>
      </div>
    </div>

    <aside class="article-author" aria-labelledby="author-title">
      <div class="container container--text article-author__inner">
        <WaveMark class="article-author__mark" />
        <div>
          <p class="eyebrow">About the author</p>
          <h2 class="article-author__name" id="author-title">{editorialAuthor.name}</h2>
          <p class="article-author__bio">{editorialAuthor.bio}</p>
          <a class="text-link" href={withBase('/about/')}>
            Read our point of view
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </aside>

    {older && (
      <section class="article-next" aria-labelledby="next-title">
        <div class="container container--wide">
          <div class="article-next__head">
            <p class="eyebrow" id="next-title">Next story</p>
            {newer && (
              <a class="article-next__previous" href={articleUrl(newer)}>
                <Icon name="arrow-left" size={14} />
                Newer: {newer.data.title}
              </a>
            )}
          </div>
          <a class="article-next__card" href={articleUrl(older)}>
            <span class="article-next__topic">{getArticleTopic(older).name}</span>
            <span class="article-next__title">{older.data.title}</span>
            <span class="article-next__copy">{older.data.description}</span>
            <span class="article-next__cta">
              Read next
              <Icon name="arrow-right" size={16} />
            </span>
          </a>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="related-stories" aria-labelledby="related-title">
        <div class="container container--wide">
          <div class="related-stories__head">
            <div>
              <p class="eyebrow">Keep reading</p>
              <h2 class="related-stories__title" id="related-title">Related stories</h2>
            </div>
            <a class="arrow-link" href={topicUrl(topic.slug)}>
              More in {topic.name}
              <Icon name="arrow-right" size={15} />
            </a>
          </div>

          <div class="related-stories__grid">
            {related.map((item, index) => (
              <ArticleCard article={item} index={index} headingLevel="h3" />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-head {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .article-breadcrumb a {
    transition: color var(--duration-fast) ease;
  }

  .article-breadcrumb a:hover {
    color: var(--accent);
  }

  .article-breadcrumb span {
    color: var(--line-strong);
  }

  .article-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.55fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: end;
    padding-top: clamp(1.75rem, 3.5vw, 3rem);
  }

  .article-title {
    max-width: 16ch;
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.9rem + 4.2vw, 5.6rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .article-standfirst {
    max-width: 42rem;
    margin-top: 1.35rem;
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .article-head__aside {
    padding-bottom: 0.35rem;
    border-top: 1px solid var(--line);
  }

  .article-byline {
    padding-top: 1rem;
  }

  .article-byline__label,
  .article-facts dt {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .article-byline__name {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .article-facts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .article-facts div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  .article-facts dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .article-facts dd a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .article-share {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .article-cover {
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
  }

  .article-cover__frame {
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    aspect-ratio: 16 / 9;
  }

  .article-cover__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-cover__caption {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 0.7rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .article-cover__credit {
    flex: none;
    text-align: right;
  }

  .article-body {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .article-footer__back {
    gap: 0.5rem;
  }

  .article-author {
    margin-top: var(--section-space);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .article-author__inner {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .article-author__mark {
    width: 2.4rem;
    height: 2.4rem;
    margin-top: 0.25rem;
    color: var(--accent);
  }

  .article-author__name {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .article-author__bio {
    max-width: 38rem;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .article-author .text-link {
    margin-top: 1.1rem;
  }

  .article-next {
    padding-top: var(--section-space);
  }

  .article-next__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .article-next__previous {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 50%;
    overflow: hidden;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color var(--duration-fast) ease;
  }

  .article-next__previous:hover {
    color: var(--accent);
  }

  .article-next__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem 2rem;
    align-items: end;
    padding-top: 1.5rem;
  }

  .article-next__topic {
    grid-column: 1 / -1;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .article-next__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.2rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
    transition: color var(--duration-fast) ease;
  }

  .article-next__copy {
    max-width: 38rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .article-next__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    grid-column: 2;
    grid-row: 2 / span 2;
    align-self: end;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.04em;
    color: var(--ink);
    white-space: nowrap;
  }

  .article-next__card:hover .article-next__title {
    color: var(--accent);
  }

  .article-next__card:hover .article-next__cta svg {
    transform: translateX(4px);
  }

  .article-next__cta svg {
    transition: transform var(--duration) var(--ease-out);
  }

  .related-stories {
    padding-top: var(--section-space);
  }

  .related-stories__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .related-stories__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .related-stories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (max-width: 900px) {
    .article-head__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }

    .article-head__aside {
      max-width: 26rem;
    }

    .article-title {
      max-width: 18ch;
    }

    .related-stories__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  @media (max-width: 700px) {
    .article-cover__frame {
      aspect-ratio: 4 / 3;
    }

    .article-cover__caption {
      flex-direction: column;
      gap: 0.25rem;
    }

    .article-cover__credit {
      text-align: left;
    }

    .article-next__card {
      grid-template-columns: 1fr;
    }

    .article-next__cta {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 0.5rem;
    }

    .article-next__previous {
      display: none;
    }

    .related-stories__head {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .article-author__inner {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .article-facts div {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }
</style>
