---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EditorialNote from '../components/EditorialNote.astro';
import FeaturedStory from '../components/FeaturedStory.astro';
import Icon from '../components/Icon.astro';
import TopicIndex from '../components/TopicIndex.astro';
import WaveMark from '../components/WaveMark.astro';
import { site } from '../data/site';
import { topics } from '../data/topics';
import { absoluteUrl, withBase } from '../lib/paths';
import {
  articleCountLabel,
  articleUrl,
  formatDate,
  getFeaturedArticle,
  getPublishedArticles,
  getTopicCounts,
  getArticleTopic,
} from '../lib/articles';

const articles = await getPublishedArticles();
const featured = getFeaturedArticle(articles);
const latest = articles.filter((article) => article.id !== featured.id).slice(0, 3);
const rest = articles.filter(
  (article) => article.id !== featured.id && !latest.some((item) => item.id === article.id),
);
const counts = getTopicCounts(articles);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: absoluteUrl('/'),
    description: site.description,
    inLanguage: 'en-GB',
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: absoluteUrl('/'),
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl('/icon-512.png'),
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Brine — Issue 04',
    url: absoluteUrl('/'),
    description: site.description,
    hasPart: articles.map((article) => ({
      '@type': 'Article',
      headline: article.data.title,
      url: absoluteUrl(articleUrl(article)),
      datePublished: article.data.publishedAt.toISOString(),
    })),
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container container--wide">
      <div class="home-hero__top" data-reveal>
        <p class="eyebrow eyebrow--accent">
          <span class="eyebrow__rule"></span>
          Independent journal
        </p>
        <p class="home-hero__issue">
          Issue {site.issue.number} <span aria-hidden="true">/</span> {site.issue.season}
        </p>
      </div>

      <div class="home-hero__grid">
        <div class="home-hero__main">
          <h1 class="home-hero__title" id="home-title" data-reveal>
            A journal for the attention you have <em>left</em>.
          </h1>

          <div class="home-hero__footer" data-reveal style="--reveal-delay: 100ms">
            <p class="home-hero__lede">
              Essays on attention, design, and the texture of digital life. No feed. No algorithm.
              Just a small, considered place to read.
            </p>
            <div class="home-hero__actions">
              <a class="btn" href={withBase('/journal/')}>
                Read the journal
                <Icon name="arrow-right" size={16} />
              </a>
              <a class="text-link" href={withBase('/about/')}>Our point of view</a>
            </div>
          </div>
        </div>

        <aside class="issue-card" aria-labelledby="issue-card-title" data-reveal style="--reveal-delay: 160ms">
          <div class="issue-card__head">
            <WaveMark class="issue-card__mark" />
            <p class="issue-card__label">The current issue</p>
          </div>
          <h2 class="issue-card__title" id="issue-card-title">{site.issue.name}</h2>
          <p class="issue-card__copy">
            Eight essays on the rooms, rituals, and small decisions that shape where our attention
            goes — and how we might get some of it back.
          </p>
          <div class="issue-card__stats">
            <p><strong>{articles.length}</strong> stories</p>
            <p><strong>{topics.length}</strong> topics</p>
            <p><strong>1</strong> quiet corner</p>
          </div>
          <a class="issue-card__link" href="#latest">
            Browse the issue
            <Icon name="arrow-right" size={15} />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <FeaturedStory article={featured} />

  <section class="latest" id="latest" aria-labelledby="latest-title">
    <div class="container container--wide">
      <div class="latest__head" data-reveal>
        <div>
          <p class="eyebrow">From the journal</p>
          <h2 class="latest__title" id="latest-title">Latest stories</h2>
        </div>
        <a class="arrow-link" href={withBase('/journal/')}>
          All {articles.length} stories
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="latest__grid">
        {latest.map((article, index) => (
          <div data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <ArticleCard article={article} index={index + 1} />
          </div>
        ))}
      </div>

      {rest.length > 0 && (
        <div class="also" data-reveal>
          <div class="also__head">
            <p class="eyebrow">Also in Issue {site.issue.number}</p>
            <p class="also__count">{articleCountLabel(rest.length)}</p>
          </div>
          <ul class="also__list">
            {rest.map((article, index) => {
              const topic = getArticleTopic(article);
              return (
                <li>
                  <a class="also__row" href={articleUrl(article)}>
                    <span class="also__number" aria-hidden="true">
                      {String(index + 5).padStart(2, '0')}
                    </span>
                    <span class="also__body">
                      <span class="also__topic">{topic.name}</span>
                      <span class="also__title">{article.data.title}</span>
                    </span>
                    <span class="also__date">{formatDate(article.data.publishedAt, 'short')}</span>
                    <Icon name="arrow-up-right" size={15} class="also__arrow" />
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  </section>

  <TopicIndex counts={counts} />

  <EditorialNote />
</BaseLayout>

<style>
  .home-hero {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .home-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .home-hero__issue {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .home-hero__issue span {
    margin-inline: 0.2rem;
    color: var(--line-strong);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.72fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-top: clamp(2.25rem, 5vw, 4.5rem);
  }

  .home-hero__title {
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 2.2rem + 5.6vw, 7.2rem);
    font-weight: 480;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .home-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .home-hero__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    max-width: 54rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .home-hero__lede {
    max-width: 30rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.28rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }

  .issue-card {
    position: relative;
    padding: 1.5rem 1.4rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .issue-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .issue-card__mark {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--accent);
  }

  .issue-card__label {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .issue-card__title {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.15rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .issue-card__copy {
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .issue-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .issue-card__stats strong {
    font-weight: 600;
    color: var(--ink);
  }

  .issue-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--ink);
    transition: color var(--duration-fast) ease;
  }

  .issue-card__link:hover {
    color: var(--accent);
  }

  .issue-card__link svg {
    transition: transform var(--duration) var(--ease-out);
  }

  .issue-card__link:hover svg {
    transform: translateX(3px);
  }

  .latest {
    margin-top: var(--section-space);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .latest__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .latest__title {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .also {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .also__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .also__count {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .also__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
  }

  .also__row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0.9rem;
    padding: 1.05rem 0.4rem;
    margin-inline: -0.4rem;
    border-top: 1px solid var(--line);
    border-radius: var(--radius-xs);
    transition: background-color var(--duration-fast) ease;
  }

  .also__row:hover {
    background: var(--accent-soft);
  }

  .also__number {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--line-strong);
  }

  .also__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .also__topic {
    font-family: var(--font-ui);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .also__title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .also__date {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    color: var(--muted);
    white-space: nowrap;
  }

  :global(.also__arrow) {
    color: var(--muted);
    transition:
      transform var(--duration) var(--ease-out),
      color var(--duration-fast) ease;
  }

  .also__row:hover :global(.also__arrow) {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (max-width: 1000px) {
    .home-hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .home-hero__title {
      max-width: 13ch;
    }

    .issue-card {
      max-width: 28rem;
    }
  }

  @media (max-width: 800px) {
    .home-hero__footer {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      align-items: start;
    }

    .latest__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .also__list {
      grid-template-columns: 1fr;
    }

    .latest__head {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .home-hero__issue {
      display: none;
    }

    .home-hero__title {
      font-size: clamp(3.1rem, 2rem + 8vw, 4.6rem);
    }

    .also__row {
      grid-template-columns: 1.6rem minmax(0, 1fr) 1rem;
      gap: 0.7rem;
    }

    .also__date {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .home-hero__title {
      font-size: 2.9rem;
    }

    .home-hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
