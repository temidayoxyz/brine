---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageMasthead from '../../components/PageMasthead.astro';
import { topics } from '../../data/topics';
import {
  articleCountLabel,
  articleUrl,
  formatDate,
  getPublishedArticles,
} from '../../lib/articles';
import { absoluteUrl, withBase } from '../../lib/paths';

const articles = await getPublishedArticles();

const topicEntries = topics.map((topic) => ({
  topic,
  articles: articles.filter((article) => article.data.category === topic.slug),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Topics — Brine',
  description: 'Five ways into Brine: attention, design, digital life, culture, and living.',
  url: absoluteUrl('/topics/'),
  inLanguage: 'en-GB',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: topicEntries.map(({ topic }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: topic.name,
      url: absoluteUrl(`/topics/${topic.slug}/`),
    })),
  },
};
---

<BaseLayout
  title="Topics"
  description="Five ways into Brine: attention, design, digital life, culture, and living. Follow a thread through the journal."
  jsonLd={jsonLd}
>
  <PageMasthead
    eyebrow="Topics"
    title="Five ways in."
    intro="Follow a thread through the journal. Each topic gathers essays that share a question, not just a subject."
    meta={`${topics.length} topics · ${articles.length} stories`}
  />

  <section class="topics" aria-labelledby="topics-list-title">
    <div class="container container--wide">
      <h2 class="visually-hidden" id="topics-list-title">All topics</h2>

      <div class="topics__list">
        {topicEntries.map(({ topic, articles: topicArticles }, index) => (
          <article class="topic-block" data-reveal style={`--reveal-delay: ${index * 40}ms`}>
            <div class="topic-block__head">
              <span class="topic-block__number" aria-hidden="true">{topic.number}</span>
              <h2 class="topic-block__title">
                <a href={withBase(`/topics/${topic.slug}/`)}>{topic.name}</a>
              </h2>
              <span class="topic-block__count">{articleCountLabel(topicArticles.length)}</span>
            </div>

            <div class="topic-block__body">
              <div class="topic-block__intro">
                <p>{topic.intro}</p>
                <a class="arrow-link" href={withBase(`/topics/${topic.slug}/`)}>
                  Explore {topic.name}
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>

              <ul class="topic-block__stories" aria-label={`Latest in ${topic.name}`}>
                {topicArticles.slice(0, 3).map((article) => (
                  <li>
                    <a href={articleUrl(article)}>
                      <span class="topic-block__date">
                        {formatDate(article.data.publishedAt, 'short')}
                      </span>
                      <span class="topic-block__story-title">{article.data.title}</span>
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topics {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .topics__list {
    border-bottom: 1px solid var(--line);
  }

  .topic-block {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 4vw, 3.2rem);
    border-top: 1px solid var(--line);
  }

  .topic-block__head {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    align-content: start;
  }

  .topic-block__number {
    grid-row: span 2;
    padding-top: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .topic-block__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.5vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .topic-block__title a {
    transition: color var(--duration-fast) ease;
  }

  .topic-block__title a:hover {
    color: var(--accent);
  }

  .topic-block__count {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .topic-block__body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .topic-block__intro p {
    max-width: 30rem;
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .topic-block__intro .arrow-link {
    margin-top: 1.1rem;
  }

  .topic-block__stories {
    border-top: 1px solid var(--line);
  }

  .topic-block__stories li {
    border-bottom: 1px solid var(--line);
  }

  .topic-block__stories a {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.35rem;
    margin-inline: -0.35rem;
    border-radius: var(--radius-xs);
    transition: background-color var(--duration-fast) ease;
  }

  .topic-block__stories a:hover {
    background: var(--accent-soft);
  }

  .topic-block__date {
    font-family: var(--font-ui);
    font-size: 0.625rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .topic-block__story-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .topic-block__stories svg {
    color: var(--muted);
    transition:
      transform var(--duration) var(--ease-out),
      color var(--duration-fast) ease;
  }

  .topic-block__stories a:hover svg {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .topic-block {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .topic-block__head {
      grid-template-columns: 2rem auto 1fr;
      align-items: baseline;
    }

    .topic-block__number {
      grid-row: auto;
      padding-top: 0;
    }

    .topic-block__count {
      justify-self: end;
    }

    .topic-block__body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .topic-block__stories a {
      grid-template-columns: 1fr 1rem;
      gap: 0.2rem 0.5rem;
    }

    .topic-block__date {
      grid-column: 1 / -1;
    }
  }
</style>
